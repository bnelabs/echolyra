# Copy to .env (gitignored). NEVER commit real keys to the public hackathon repo.
META_API_KEY=LLM_your_key_here
META_BASE_URL=https://api.meta.ai/v1
# Contributor = cheap, but inputs/outputs may train Meta models. Demo only.
META_MODEL_SPARK=muse-spark-1.3-contributor
META_MODEL_SPARK_STANDARD=muse-spark-1.3
META_MODEL_SAM=sam-3.1
META_MODEL_IMAGE=muse-image-1.0
META_MODEL_ASR=muse-voice-transcribe-1.0
META_REASONING_EFFORT=low
